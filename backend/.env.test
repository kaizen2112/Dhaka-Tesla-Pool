# e2e tests only (npm run test:e2e). A separate database on the same compose Postgres —
# the tests TRUNCATE every table, so this must never point at the dev database.
# Local-only credentials, same as .env.example — safe to commit.
DATABASE_URL="postgresql://tesla:tesla@localhost:5432/tesla_pool_test?schema=public"
DIRECT_URL="postgresql://tesla:tesla@localhost:5432/tesla_pool_test?schema=public"

JWT_SECRET="e2e-test-secret"
JWT_EXPIRES_IN="1h"
