# Local Docker Postgres (root docker-compose.yml → db service).
# Both URLs point at the same instance locally. Neon needs them to differ
# (pooled vs direct connection) once deployed — see docs/DATABASE.md.
DATABASE_URL="postgresql://tesla:tesla@localhost:5432/tesla_pool?schema=public"
DIRECT_URL="postgresql://tesla:tesla@localhost:5432/tesla_pool?schema=public"
