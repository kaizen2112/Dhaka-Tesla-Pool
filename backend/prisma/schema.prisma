// Dhaka Tesla Pool — starter schema. See docs/DATABASE.md for rationale.
// Run `npx prisma migrate dev --name init` after dropping this into backend/prisma/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
}

enum RideStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicle         Vehicle?         @relation("DriverVehicle")
  rideRequests    RideRequest[]
  poolMemberships PoolMembership[]
  wallet          Wallet?
}

model Vehicle {
  id        String   @id @default(uuid())
  driverId  String   @unique
  driver    User     @relation("DriverVehicle", fields: [driverId], references: [id])
  name      String // e.g. "Bullet"
  capacity  Int
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())

  pools Pool[]
}

model RideRequest {
  id              String     @id @default(uuid())
  passengerId     String
  passenger       User       @relation(fields: [passengerId], references: [id])
  pickupZone      String
  destinationZone String
  seats           Int        @default(1)
  status          RideStatus @default(REQUESTED)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  membership PoolMembership?

  @@index([passengerId])
}

model Pool {
  id              String     @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])
  pickupZone      String
  destinationZone String
  occupiedSeats   Int        @default(0)
  status          RideStatus @default(REQUESTED)
  version         Int        @default(0) // optimistic-lock counter, see docs/ARCHITECTURE.md §6
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships   PoolMembership[]
  statusHistory RideStatusHistory[]

  @@index([vehicleId])
}

model PoolMembership {
  id            String      @id @default(uuid())
  poolId        String
  pool          Pool        @relation(fields: [poolId], references: [id])
  rideRequestId String      @unique
  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id])
  passengerId   String
  passenger     User        @relation(fields: [passengerId], references: [id])
  seats         Int
  farePoysha    Int
  joinedAt      DateTime    @default(now())

  @@index([poolId])
}

model RideStatusHistory {
  id         String      @id @default(uuid())
  poolId     String
  pool       Pool        @relation(fields: [poolId], references: [id])
  fromStatus RideStatus?
  toStatus   RideStatus
  changedAt  DateTime    @default(now())
  note       String?

  @@index([poolId])
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  balancePoysha Int      @default(0)
  updatedAt     DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String   @id @default(uuid())
  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id])
  amountPoysha Int // negative = debit, positive = credit
  type         String // "RIDE_PAYMENT" | "TOPUP" | ...
  reference    String? // e.g. a PoolMembership id
  createdAt    DateTime @default(now())

  @@index([walletId])
}
