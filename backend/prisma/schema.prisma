// Dhaka Tesla Pool — schema. See docs/DATABASE.md for full rationale per table.

generator client {
  provider = "prisma-client-js"
}

// Connection URLs live in prisma.config.ts (CLI) and prisma.service.ts (runtime adapter) —
// Prisma 7 no longer allows url/directUrl in the schema file itself.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  DRIVER
}

enum RideStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  WALLET
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model User {
  id            String              @id @default(uuid())
  name          String
  email         String              @unique
  passwordHash  String
  role          UserRole
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  vehicle       Vehicle?
  rideRequests  RideRequest[]
  memberships   PoolMembership[]
  wallet        Wallet?
  statusChanges RideStatusHistory[]
}

model Vehicle {
  id        String   @id @default(uuid())
  driverId  String   @unique
  driver    User     @relation(fields: [driverId], references: [id])
  name      String
  capacity  Int
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pools     Pool[]
}

model RideRequest {
  id              String              @id @default(uuid())
  passengerId     String
  passenger       User                @relation(fields: [passengerId], references: [id])
  pickupZone      String
  destinationZone String
  seats           Int
  status          RideStatus          @default(REQUESTED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  membership      PoolMembership?
  history         RideStatusHistory[]

  @@index([passengerId, createdAt])
  @@index([status])
}

model Pool {
  id              String              @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])
  pickupZone      String
  destinationZone String
  capacity        Int
  occupiedSeats   Int
  status          RideStatus          @default(MATCHED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  memberships     PoolMembership[]
  history         RideStatusHistory[]

  @@index([vehicleId, status])
}

model PoolMembership {
  id                String             @id @default(uuid())
  poolId            String
  pool              Pool               @relation(fields: [poolId], references: [id])
  rideRequestId     String             @unique
  rideRequest       RideRequest        @relation(fields: [rideRequestId], references: [id])
  passengerId       String
  passenger         User               @relation(fields: [passengerId], references: [id])
  seats             Int
  farePoysha        Int
  joinedAt          DateTime           @default(now())
  cancelledAt       DateTime?
  paymentMethod     PaymentMethod?
  paidAt            DateTime?
  walletTransaction WalletTransaction?

  @@index([poolId])
}

model RideStatusHistory {
  id            String       @id @default(uuid())
  poolId        String?
  pool          Pool?        @relation(fields: [poolId], references: [id])
  rideRequestId String?
  rideRequest   RideRequest? @relation(fields: [rideRequestId], references: [id])
  fromStatus    RideStatus?
  toStatus      RideStatus
  actorUserId   String
  actor         User         @relation(fields: [actorUserId], references: [id])
  changedAt     DateTime     @default(now())

  @@index([poolId])
  @@index([rideRequestId])
}

model Wallet {
  id            String              @id @default(uuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id])
  balancePoysha Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transactions  WalletTransaction[]
}

model WalletTransaction {
  id               String                @id @default(uuid())
  walletId         String
  wallet           Wallet                @relation(fields: [walletId], references: [id])
  type             WalletTransactionType
  amountPoysha     Int
  poolMembershipId String?               @unique
  poolMembership   PoolMembership?       @relation(fields: [poolMembershipId], references: [id])
  createdAt        DateTime              @default(now())

  @@index([walletId, createdAt])
}
