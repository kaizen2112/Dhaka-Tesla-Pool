# Values docker-compose.yml passes to the containers. Optional: each one has a local
# default in docker-compose.yml. Copy to `.env` (gitignored) to override. No real secrets here.

# Postgres container (and the URLs the backend builds from them)
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=tesla_pool

# Backend auth — use a long random value anywhere that isn't your own machine
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Browser origin the API accepts (CORS) — the frontend's URL
FRONTEND_ORIGIN=http://localhost:3001

# Frontend image build arg: the API URL as the browser sees it. Baked in at build time,
# so rebuild the frontend after changing it (docker compose up --build).
NEXT_PUBLIC_API_URL=http://localhost:3000
